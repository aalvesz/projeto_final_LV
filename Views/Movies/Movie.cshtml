@{
    ViewData["Title"] = "Detalhes do Filme";
}

<div class="max-w-5xl mx-auto px-4 py-8">
    <!-- Título e ano -->
    <div class="flex flex-col md:flex-row items-start gap-8">
        <img src="https://image.tmdb.org/t/p/w500/8UlWHLMpgZm9bxKQb9gvP2EiW3.jpg" 
             alt="Interestelar" 
             class="w-64 rounded-lg shadow-xl">

        <div class="flex-1">
            <h1 class="text-4xl font-bold text-gray-900">Interestelar</h1>
            <p class="text-xl text-gray-600 mt-2">Interstellar • 2014 • 2h 49min</p>

            <!-- Gêneros -->
            <div class="flex flex-wrap gap-2 mt-4">
                <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full text-sm font-medium">Aventura</span>
                <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full text-sm font-medium">Drama</span>
                <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full text-sm font-medium">Ficção Científica</span>
            </div>

            <!-- Avaliação -->
            <div class="flex items-center gap-6 mt-6">
                <div class="flex items-center">
                    <svg class="w-8 h-8 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.963a1 1 0 00.95.69h4.163c.969 0 1.371 1.24.588 1.81l-3.373 2.456a1 1 0 00-.364 1.118l1.287 3.963c.3.921-.755 1.688-1.54 1.118l-3.373-2.456a1 1 0 00-1.176 0l-3.373 2.456c-.784.57-1.84-.197-1.54-1.118l1.287-3.963a1 1 0 00-.364-1.118L2.335 9.39c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 00.95-.69l1.286-3.963z"/>
                    </svg>
                    <span class="text-2xl font-bold ml-2">8.6</span>
                    <span class="text-gray-500 ml-1">/10</span>
                </div>
                <p class="text-gray-600">IMDb • 2.1 milhões de avaliações</p>
            </div>

            <!-- Recomendação baseada no clima -->
            <div class="mt-8 p-6 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border border-indigo-200">
                <p class="text-lg font-semibold text-indigo-900 flex items-center">
                    <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h10a4 4 0 004-4 4 4 0 00-4-4H7a4 4 0 00-4 4z"/>
                    </svg>
                    Perfeito para hoje em @ViewData["CidadeAtual"]
                </p>
                <p class="text-gray-700 mt-2">Céu nublado com 18°C — Ideal para filmes épicos e emocionantes!</p>
            </div>
        </div>
    </div>

    <!-- Sinopse -->
    <div class="mt-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Sinopse</h2>
        <p class="text-gray-700 leading-relaxed text-lg">
            Em um futuro onde a Terra está ficando inabitável, um grupo de astronautas 
            viaja através de um buraco de minhoca em busca de um novo lar para a humanidade. 
            Com visual deslumbrante e trilha sonora inesquecível, Interestelar é uma jornada 
            sobre amor, tempo e sobrevivência.
        </p>
    </div>

    <!-- Elenco principal -->
    <div class="mt-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Elenco Principal</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <div class="text-center">
                <img src="https://image.tmdb.org/t/p/w185/pwS5T9W2fghii6Q8RiiIlR6TbvX.jpg" alt="Matthew McConaughey" class="w-32 h-32 rounded-full mx-auto object-cover">
                <p class="mt-3 font-medium">Matthew McConaughey</p>
                <p class="text-sm text-gray-600">Cooper</p>
            </div>
            <div class="text-center">
                <img src="https://image.tmdb.org/t/p/w185/2e5kU8Tcdh7R7wd2nV0D3pV3b7k.jpg" alt="Anne Hathaway" class="w-32 h-32 rounded-full mx-auto object-cover">
                <p class="mt-3 font-medium">Anne Hathaway</p>
                <p class="text-sm text-gray-600">Brand</p>
            </div>
            <!-- Adicione mais atores se quiser -->
        </div>
    </div>

    <!-- Botão Voltar -->
    <div class="mt-12">
        <a href="/" class="inline-block bg-gray-800 text-white px-6 py-3 rounded-lg font-medium hover:bg-gray-700 transition">
            ← Voltar ao catálogo
        </a>
    </div>
</div>