@model IReadOnlyList<projeto_final_LV.Models.Movie>

@{
    ViewData["Title"] = "Catálogo Local";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Catálogo Local</h1>
        <a class="btn btn-outline-secondary" asp-controller="Tmdb" asp-action="Search">Buscar no TMDb</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Nenhum filme importado ainda.</div>
        return;
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>TMDbId</th>
                    <th>Lançamento</th>
                    <th>Nota</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Id</td>
                        <td>@f.Titulo</td>
                        <td>@f.TmdbId</td>
                        <td>@(f.DataLancamento?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@(f.NotaMedia?.ToString() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
