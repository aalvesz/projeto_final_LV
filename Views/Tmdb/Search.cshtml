@model projeto_final_LV.Models.Tmdb.TmdbPagedResponse<projeto_final_LV.Models.Tmdb.TmdbMovieSearchResultDto>

@{
    ViewData["Title"] = "Buscar no TMDb";
    var q = (string?)ViewBag.Query ?? "";
}

<div class="container py-4">
    <h1 class="mb-3">Buscar filmes (TMDb)</h1>

    <form method="get" asp-controller="Tmdb" asp-action="Search" class="row g-2 mb-4">
        <div class="col-12 col-md-9">
            <input name="query" value="@q" class="form-control" placeholder="Digite o título..." />
        </div>
        <div class="col-12 col-md-3">
            <button class="btn btn-primary w-100" type="submit">Buscar</button>
        </div>
    </form>

    @Html.AntiForgeryToken()

    @if (Model is null)
    {
        <div class="text-muted">Digite um termo e clique em Buscar.</div>
        return;
    }

    @if (Model.Results.Count == 0)
    {
        <div class="alert alert-warning">Nenhum resultado encontrado.</div>
        return;
    }

    <div class="row g-3">
        @foreach (var item in Model.Results)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <partial name="_TmdbMovieCard" model="item" />
            </div>
        }
    </div>

    <nav class="mt-4">
        <ul class="pagination flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="Tmdb"
                   asp-action="Search"
                   asp-route-query="@q"
                   asp-route-page="@(Model.Page - 1)">
                    Anterior
                </a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">Página @Model.Page de @Model.TotalPages</span>
            </li>

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="Tmdb"
                   asp-action="Search"
                   asp-route-query="@q"
                   asp-route-page="@(Model.Page + 1)">
                    Próxima
                </a>
            </li>
        </ul>
    </nav>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
  const token = tokenEl ? tokenEl.value : null;

  document.querySelectorAll(".js-import").forEach(btn => {
    btn.addEventListener("click", async () => {
      const tmdbId = btn.dataset.tmdbId;

      try {
        const form = new FormData();
        form.append("tmdbId", tmdbId);

        const res = await axios.post("/Filmes/ImportFromTmdb", form, {
          headers: token ? { "RequestVerificationToken": token } : {}
        });

        alert(`Import OK (stub). tmdbId=${res.data.tmdbId}`);
      } catch (e) {
        console.error(e);
        alert("Falha ao importar. Veja o console.");
      }
    });
  });
</script>
