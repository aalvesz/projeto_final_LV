@model projeto_final_LV.Models.Tmdb.TmdbMovieSearchResultDto

<div class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title mb-2">@Model.Title</h5>

       @if (!string.IsNullOrEmpty(Model.PosterPath))
        {
            <img src="@($"https://image.tmdb.org/t/p/w500{Model.PosterPath}")"
                alt="@Model.Title"
                class="card-img-top"
                style="height: 420px; object-fit: cover;"
                onerror="this.src='https://via.placeholder.com/500x750/222222/cccccc?text=Sem+Poster';">
        }
        else
        {
            <img src="https://via.placeholder.com/500x750/222222/cccccc?text=Sem+Poster"
                alt="Sem poster"
                class="card-img-top"
                style="height: 420px; object-fit: cover;">
        }

        <div class="text-muted small mb-2">
            @if (!string.IsNullOrWhiteSpace(Model.ReleaseDate))
            {
                <span>Lançamento: @Model.ReleaseDate</span>
            }
            @if (Model.VoteAverage is not null)
            {
                <span class="ms-2">Nota: @Model.VoteAverage</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Overview))
        {
            <p class="card-text">
                @(Model.Overview!.Length > 180 ? Model.Overview[..180] + "..." : Model.Overview)
            </p>
        }

        <div class="mt-auto d-grid gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Tmdb" asp-action="Details" asp-route-id="@Model.Id">
            Ver detalhes
            </a>

            <button type="button"
                    class="btn btn-success js-import"
                    data-tmdb-id="@Model.Id">
                Importar
            </button>
        </div>
    </div>
</div>
