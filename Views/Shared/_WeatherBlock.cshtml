@model projeto_final_LV.Models.ViewModels.WeatherBlockVm

@if (!Model.HasCoordinates)
{
    <div class="alert alert-info mb-0">
        Para exibir a previsão do tempo, preencha Latitude/Longitude do filme.
    </div>
    return;
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning mb-0">@Model.Message</div>
    return;
}

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-2">Previsão do tempo (Open-Meteo)</h5>
        <div class="text-muted small mb-2">Data: @Model.Date</div>
        <div class="d-flex gap-3">
            <div><strong>Mín:</strong> @Model.Min °C</div>
            <div><strong>Máx:</strong> @Model.Max °C</div>
        </div>
    </div>
</div>
