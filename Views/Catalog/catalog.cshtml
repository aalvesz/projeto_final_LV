@{
    ViewData["Title"] = "Catálogo de Filmes";
}

<div class="box-catalog">
    <h1>Catálogo de Filmes</h1>
    <p class="page-catalog" >Explore nossa coleção de filmes disponíveis para você.</p>
</div>


<div class="box-function row-cols-md-5 mb-4">

    <a class="btn btn-primary" data-bs-toggle="offcanvas" href="#offcanvasExample" role="button" aria-controls="offcanvasExample">
    Link with href
    </a>
    <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
    Button with data-bs-target
    </button>
    <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
    Button with data-bs-target
    </button>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasExampleLabel">Offcanvas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
                <div class="offcanvas-body">
                    <div>
                        Some text as placeholder. In real life you can have the elements you have chosen. Like, text, images, lists, etc.
                    </div>
                        <div class="dropdown mt-3">
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Dropdown button
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Action</a></li>
                                <li><a class="dropdown-item" href="#">Another action</a></li>
                                <li><a class="dropdown-item" href="#">Something else here</a></li>
                            </ul>
                        </div>
                </div>
        </div>

</div>

<!-- Cards -->
   
<div class="d-flex justify-content-center gap-4 mb-5 flex-wrap ">
    <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/avatar.png")" class="card-img-cartaz" alt="avatar">
            <div class="card-body">
                <h5 class="card-title">Avatar - Fogo e cinzas</h5>
                <p class="card-text">No exuberante planeta Pandora, Jake Sully adota um corpo híbrido Na'vi/humano para se infiltrar na população local.</p>
                <a href="~/Movie/movie" class="btn btn-primary">Ver horários</a>
            </div>
    </div>
    
     <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/fnaf02.jpg")" class="card-img-cartaz" alt="fnaf">
            <div class="card-body">
                <h5 class="card-title">Five nights at Freddy's 2</h5>
                <p class="card-text">A sequência se aprofunda nos mistérios do estabelecimento infantil Freddy Fazbear’s Pizza.</p>
                <a href="~/Movie/movie" class="btn btn-primary">Ver horários</a>
            </div>
    </div>

     <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/wicked01.jpg")" class="card-img-cartaz" alt="Wicked">
            <div class="card-body">
                <h5 class="card-title">Wicked - Parte 1</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                <a href="~/Movie/movie" class="btn btn-primary">Ver horários</a>
            </div>
    </div>

     <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/avatar.png")" class="card-img-cartaz" alt="avatar">
            <div class="card-body">
                <h5 class="card-title">Card title</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                <a href="~/Movie/movie" class="btn btn-primary">Ver horários</a>
            </div>
    </div>
</div>
