@{
    ViewData["Title"] = "Catálogo de Filmes";
}

<div class="box-catalog">
    <h1>Catálogo de Filmes</h1>
    <p class="page-catalog" >Explore nossa coleção de filmes disponíveis para você.</p>
</div>

<!-- Cards -->
   
<div class="d-flex justify-content-center gap-4 mb-5 flex-wrap ">
    <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/avatar.png")" class="card-img-cartaz" alt="avatar">
            <div class="card-body">
                <h5 class="card-title">Avatar - Fogo e cinzas</h5>
                <p class="card-text">No exuberante planeta Pandora, Jake Sully adota um corpo híbrido Na'vi/humano para se infiltrar na população local.</p>
                <a href="#" class="btn btn-primary">Ver horários</a>
            </div>
    </div>
    
     <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/fnaf02.jpg")" class="card-img-cartaz" alt="fnaf">
            <div class="card-body">
                <h5 class="card-title">Five nights at Freddy's 2</h5>
                <p class="card-text">A sequência se aprofunda nos mistérios do estabelecimento infantil Freddy Fazbear’s Pizza.</p>
                <a href="#" class="btn btn-primary">Ver horários</a>
            </div>
    </div>

     <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/wicked01.jpg")" class="card-img-cartaz" alt="Wicked">
            <div class="card-body">
                <h5 class="card-title">Wicked - Parte 1</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                <a href="#" class="btn btn-primary">Ver horários</a>
            </div>
    </div>

     <div class="card" style="width: 18rem;">
        <img src="@Url.Content("~/lib/images/cartaz/avatar.png")" class="card-img-cartaz" alt="avatar">
            <div class="card-body">
                <h5 class="card-title">Card title</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                <a href="#" class="btn btn-primary">Ver horários</a>
            </div>
    </div>
</div>
